# Gemini authentication: adc | vertex_key | studio_key
#   adc         Vertex AI with Application Default Credentials and GOOGLE_CLOUD_PROJECT:
#                 gcloud auth application-default login
#               (docker-compose mounts ~/.config/gcloud/application_default_credentials.json)
#   vertex_key  Vertex AI with an API key in GEMINI_API_KEY (no project needed)
#   studio_key  Gemini Developer API with a Google AI Studio key in GEMINI_API_KEY
GEMINI_AUTH=adc
GEMINI_API_KEY=

# Your GCP project ID (adc only), e.g. my-coloring-books-123
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_IMAGE_LOCATION=global

GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3-pro-image

# Stable Diffusion (optional second image engine): a stable-diffusion.cpp server (sd-server)
# with FLUX.1 Kontext, e.g. http://192.168.1.20:8081. Empty: off. Only coloring pages use it.
STABLE_DIFFUSION_URL=
STABLE_DIFFUSION_STEPS=12
STABLE_DIFFUSION_SIZE=768

# App language: es | en
UI_LANGUAGE=es
