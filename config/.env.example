# Gemini authentication: adc | vertex_key | studio_key
#   adc         Vertex AI with Application Default Credentials and GOOGLE_CLOUD_PROJECT:
#                 gcloud auth application-default login
#               (docker-compose mounts ~/.config/gcloud/application_default_credentials.json)
#   vertex_key  Vertex AI with an API key in GEMINI_API_KEY (no project needed)
#   studio_key  Gemini Developer API with a Google AI Studio key in GEMINI_API_KEY
GEMINI_AUTH=adc
GEMINI_API_KEY=

# Your GCP project ID (adc only), e.g. my-coloring-books-123
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_IMAGE_LOCATION=global

GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3-pro-image

# Stable Diffusion (optional second image engine): a stable-diffusion.cpp server (sd-server)
# with FLUX.1 Kontext, e.g. http://192.168.1.20:8081. Empty: off. Only coloring pages use it.
STABLE_DIFFUSION_URL=
STABLE_DIFFUSION_STEPS=12
STABLE_DIFFUSION_SIZE=768

# Local GPU engine (optional): an open model on this computer's NVIDIA GPU, started by ./launch.sh
# when the GPU can run it. Only coloring pages use it. Qwen-Image-2.1 has a research license: do
# not sell pages drawn with it without a commercial agreement.
LOCAL_IMAGE_URL=http://local-image:8000
# 1k (30-60 s, cleaner strokes) or 2k (native, ~105 s, more background in busy scenes)
LOCAL_IMAGE_PAGE_SIZE=1k
# The GPU server's own settings (it reads only the LOCAL_IMAGE_* keys of this file). Restart it
# after a change: docker compose --profile gpu up -d local-image
# LOCAL_IMAGE_MODEL=Qwen/Qwen-Image-2.1
# LOCAL_IMAGE_STEPS=40
# Unload the model after this many idle minutes to free ~25 GB of RAM (0 keeps it loaded).
# LOCAL_IMAGE_IDLE_MINUTES=20
# LOCAL_IMAGE_PRELOAD=1
# LOCAL_IMAGE_MIN_VRAM_GB=24

# App language: es | en
UI_LANGUAGE=es
